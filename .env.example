# ---------------------------------------------------------------------------
# Cluster
# ---------------------------------------------------------------------------

CLUSTER="monadiam"
KUBE_CONTEXT="k3d-monadiam"
K3D_CONFIG="bootstrap/k3d/cluster.yaml"

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------

GODEBUG="netdns=cgo"
HELM_RETRY_ATTEMPTS="5"
HELM_RETRY_DELAY_SECONDS="5"
HELM_RETRY_MAX_DELAY_SECONDS="60"

# ---------------------------------------------------------------------------
# cert-manager
# ---------------------------------------------------------------------------

CERT_MANAGER_VERSION="v1.21.1"
CERT_MANAGER_CHART="oci://quay.io/jetstack/charts/cert-manager"

# ---------------------------------------------------------------------------
# Istio
# ---------------------------------------------------------------------------

ISTIO_VERSION="1.30.3"
ISTIO_HELM_REPO="https://istio-release.storage.googleapis.com/charts"
ISTIO_PLATFORM="k3d"
GATEWAY_API_VERSION="v1.5.1"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

HASHICORP_HELM_REPO="https://helm.releases.hashicorp.com"
VAULT_CHART_VERSION="0.34.0"
VAULT_SECRETS_OPERATOR_VERSION="1.5.0"
VAULT_NAMESPACE="vault"
VAULT_POD="vault-0"
VAULT_ADDR="https://vault.vault.svc:8200"
VAULT_CACERT="/vault/userconfig/vault-server-tls/ca.crt"
VAULT_STATE_DIR="/tmp/monadiam/k3s/vault"
VAULT_INIT_FILE="/tmp/monadiam/k3s/vault/init.json"
VAULT_KEY_SHARES="1"
VAULT_KEY_THRESHOLD="1"

# ---------------------------------------------------------------------------
# Vault auth
# ---------------------------------------------------------------------------

VAULT_KV_MOUNT="kv"
VAULT_K8S_AUTH_MOUNT="kubernetes"
VAULT_K8S_AUDIENCE="vault"
VAULT_K8S_TTL="1h"

VAULT_POLICY_NAME="monadiam-apps-read"
VAULT_K8S_ROLE="monadiam-apps"

VAULT_DATA_POLICY_NAME="monadiam-data-read"
VAULT_DATA_K8S_ROLE="monadiam-data"

VAULT_MESSAGING_POLICY_NAME="monadiam-messaging-read"
VAULT_MESSAGING_K8S_ROLE="monadiam-messaging"

VAULT_OBSERVABILITY_POLICY_NAME="monadiam-observability-read"
VAULT_OBSERVABILITY_K8S_ROLE="monadiam-observability"

VAULT_CLICKHOUSE_OPERATOR_POLICY_NAME="clickhouse-operator-read"
VAULT_CLICKHOUSE_OPERATOR_K8S_ROLE="clickhouse-operator"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

PROJECTION_JOURNAL_PARTITIONS="4"

# ---------------------------------------------------------------------------
# Stateful operators
# ---------------------------------------------------------------------------

CNPG_HELM_REPO="https://cloudnative-pg.io/charts"
CNPG_CHART_VERSION="0.29.0"
STRIMZI_CHART_VERSION="1.2.0"
ALTINITY_HELM_REPO="https://helm.altinity.com"
CLICKHOUSE_OPERATOR_CHART_VERSION="0.27.3"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_CHART="oci://registry-1.docker.io/bitnamicharts/redis"
REDIS_CHART_VERSION="28.0.0"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

PROMETHEUS_COMMUNITY_HELM_REPO="https://prometheus-community.github.io/helm-charts"
KUBE_PROMETHEUS_STACK_CHART_VERSION="87.18.1"
GRAFANA_COMMUNITY_HELM_REPO="https://grafana-community.github.io/helm-charts"
OPENTELEMETRY_HELM_REPO="https://open-telemetry.github.io/opentelemetry-helm-charts"
LOKI_CHART_VERSION="18.11.3"
TEMPO_CHART_VERSION="2.3.0"
OPENTELEMETRY_COLLECTOR_CHART_VERSION="0.171.0"
GRAFANA_ADMIN_USER="dev_grafana_admin"
