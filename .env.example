KUBECONFIG="${HOME}/.kube/config"
# ---------------------------------------------------------------------------
# Cluster
# ---------------------------------------------------------------------------

CLUSTER="monadiam"
KUBE_CONTEXT="k3d-monadiam"
K3D_CONFIG="bootstrap/k3d/cluster.yaml"

GITOPS_STATE_DIR="${HOME}/.local/state/monadiam/gitops"
GITHUB_APP_ID="5570980"
GITHUB_APP_INSTALLATION_ID="177622690"
GITHUB_APP_PRIVATE_KEY_FILE=""

# ---------------------------------------------------------------------------
# Helm
# ---------------------------------------------------------------------------

GODEBUG="netdns=cgo"
HELM_RETRY_ATTEMPTS="5"
HELM_RETRY_DELAY_SECONDS="5"
HELM_RETRY_MAX_DELAY_SECONDS="60"

# ---------------------------------------------------------------------------
# cert-manager
# ---------------------------------------------------------------------------

CERT_MANAGER_VERSION="v1.21.1"
CERT_MANAGER_CHART="oci://quay.io/jetstack/charts/cert-manager"

# ---------------------------------------------------------------------------
# Istio
# ---------------------------------------------------------------------------

ISTIO_VERSION="1.30.3"
ISTIO_HELM_REPO="https://istio-release.storage.googleapis.com/charts"
ISTIO_PLATFORM="k3d"
GATEWAY_API_VERSION="v1.5.1"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

HASHICORP_HELM_REPO="https://helm.releases.hashicorp.com"
VAULT_CHART_VERSION="0.34.0"
VAULT_SECRETS_OPERATOR_VERSION="1.5.0"
VAULT_NAMESPACE="vault"
VAULT_POD="vault-0"
VAULT_ADDR="https://vault.vault.svc:8200"
VAULT_CACERT="/vault/userconfig/vault-server-tls/ca.crt"
VAULT_STATE_DIR="/tmp/monadiam/k3s/vault"
VAULT_INIT_FILE="/tmp/monadiam/k3s/vault/init.json"
VAULT_KEY_SHARES="1"
VAULT_KEY_THRESHOLD="1"
VAULT_KV_MOUNT="kv"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_CHART="oci://registry-1.docker.io/bitnamicharts/redis"
REDIS_CHART_VERSION="28.0.0"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

PROJECTION_JOURNAL_PARTITIONS="4"
REALM_PARTITIONS="4"
POSITION_PARTITIONS="4"
ACCOUNT_PARTITIONS="1"

# ---------------------------------------------------------------------------
# Stateful operators
# ---------------------------------------------------------------------------

CNPG_HELM_REPO="https://cloudnative-pg.io/charts"
CNPG_CHART_VERSION="0.29.0"
STRIMZI_CHART_VERSION="1.2.0"
ALTINITY_HELM_REPO="https://helm.altinity.com"
CLICKHOUSE_OPERATOR_CHART_VERSION="0.27.3"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

PROMETHEUS_COMMUNITY_HELM_REPO="https://prometheus-community.github.io/helm-charts"
KUBE_PROMETHEUS_STACK_CHART_VERSION="87.18.1"
GRAFANA_COMMUNITY_HELM_REPO="https://grafana-community.github.io/helm-charts"
OPENTELEMETRY_HELM_REPO="https://open-telemetry.github.io/opentelemetry-helm-charts"
LOKI_CHART_VERSION="18.11.3"
TEMPO_CHART_VERSION="2.3.0"
OPENTELEMETRY_COLLECTOR_CHART_VERSION="0.171.0"
GRAFANA_ADMIN_USER="dev_grafana_admin"

# ---------------------------------------------------------------------------
# SeaweedFS
# ---------------------------------------------------------------------------

SEAWEEDFS_HELM_REPO="https://seaweedfs.github.io/seaweedfs/helm"
SEAWEEDFS_CHART_VERSION="4.48.0"
SEAWEEDFS_VERSION="4.48"
SEAWEEDFS_ENDPOINT="http://seaweedfs-main-s3.monadiam-data.svc:8333"
SEAWEEDFS_REGION="us-east-1"
SEAWEEDFS_AUDIT_LOG_BUCKET="audit-archive"
SEAWEEDFS_AUDIT_LOG_RETENTION_DAYS="1095"
SEAWEEDFS_CHANGE_LOG_BUCKET="change-log-archive"
SEAWEEDFS_CHANGE_LOG_RETENTION_DAYS="365"

# ---------------------------------------------------------------------------
# Applications
# ---------------------------------------------------------------------------

APPLICATIONS_IP="127.0.0.1"
IMAGE_PREPARE_TIMEOUT="15m"

SHARED_SCHEMAS_IMAGE="ghcr.io/monadiam/shared-schemas:3.4.0@sha256:db7ff1c192353c8bade54cd5fdbacee1291e2008a177c05ab90191020d5b1c3b"

ACCESS_CONTROL_IMAGE="ghcr.io/monadiam/access-control-service:1.0.6@sha256:f3d773ffebc39792d0a7147fe9f128f582afbd93141e9b1b0fcfa9f2db207b0f"
IDENTITY_IMAGE="ghcr.io/monadiam/identity-service:1.0.10@sha256:8c8d300deba282834a34ba4e11442ca9ab0fd72c296e279da8fdfa1c466e8e32"
NOTIFICATION_IMAGE="ghcr.io/monadiam/notification-service:1.0.12@sha256:c425ad68ff43ac7f7dd2da5e4f2e56bad92bce7870253721275cc3b50fdad4a6"
ORGANIZATION_IMAGE="ghcr.io/monadiam/organization-service:1.0.6@sha256:b507532051fa0b2f01ab545273a067f065d8247dfbec72536dda0074c6060afe"
HR_IMAGE="ghcr.io/monadiam/hr-service:1.0.6@sha256:a0b81f7bbd142a57e508f2306716dc5f9d2fdeb13b6a5d50ddb99aaa155dabc8"
