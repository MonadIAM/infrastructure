# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------

KAFKA_IMAGE="apache/kafka:3.9.0"
KAFKA_UI_IMAGE="provectuslabs/kafka-ui:v0.7.2"
GRAFANA_IMAGE="grafana/grafana:10.2.0"
LOKI_IMAGE="grafana/loki:2.9.2"
PROMETHEUS_IMAGE="prom/prometheus:v2.47.2"
VAULT_IMAGE="hashicorp/vault:1.21.3"
VAULT_TLS_IMAGE="alpine/openssl:3.5.7"
CONSUL_IMAGE="hashicorp/consul:1.20"
CLICKHOUSE_IMAGE="clickhouse/clickhouse-server:25.8.28"
MINIO_IMAGE="minio/minio:RELEASE.2025-04-22T22-12-26Z"
MINIO_MC_IMAGE="minio/mc:RELEASE.2025-08-13T08-35-41Z"
OTEL_COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.158.0"
TEMPO_IMAGE="grafana/tempo:2.10.0"
TERRAFORM_IMAGE="hashicorp/terraform:1.10"

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------

KAFKA_EXTERNAL_PORT="9092"
KAFKA_INTERNAL_PORT="29092"
KAFKA_CONTROLLER_PORT="29093"
KAFKA_UI_PORT="8080"
GRAFANA_PORT="3000"
PROMETHEUS_PORT="9090"
LOKI_PORT="3100"
OTEL_COLLECTOR_GRPC_PORT="4317"
OTEL_COLLECTOR_HTTP_PORT="4318"
TEMPO_HTTP_PORT="3200"
VAULT_PORT="8200"
VAULT_PUBLISHED_PORT="8200"
CONSUL_UI_PORT="8500"
CLICKHOUSE_HTTP_PORT="8123"
CLICKHOUSE_NATIVE_PORT="9000"
MINIO_API_PORT="9010"
MINIO_CONSOLE_PORT="9011"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_CLUSTER_ID="MkU3OEVBNTcwNTJENDM2Qg"
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR="1"
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR="1"
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR="1"

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

DOCKER_NETWORK_MONITORING="monitoring-network"
DOCKER_NETWORK_KAFKA="kafka-net"
DOCKER_NETWORK_VAULT="vault-net"
DOCKER_NETWORK_CONSUL="consul-net"
DOCKER_VOLUME_VAULT_CA="vault_ca"

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------

GF_SECURITY_ADMIN_USER="lambdius"
GF_AUTH_ANONYMOUS_ORG_NAME="LIAM"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_SECRET=""
AWS_ROOT_SECRET_ACCESS_KEY=""
AWS_ROOT_ACCESS_KEY_ID=""

# ---------------------------------------------------------------------------
# ClickHouse
# ---------------------------------------------------------------------------

CLICKHOUSE_USER="default"
CLICKHOUSE_DB="audit"
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT="1"

CLICKHOUSE_WRITER_USER="audit_writer"
CLICKHOUSE_READER_USER="audit_reader"

# ---------------------------------------------------------------------------
# MinIO — COLD archive for ClickHouse audit_log/change_log
# ---------------------------------------------------------------------------

MINIO_ROOT_USER="minioadmin"
MINIO_ARCHIVER_ACCESS_KEY="archiver"

MINIO_AUDIT_LOG_BUCKET="audit-archive"
MINIO_CHANGE_LOG_BUCKET="change-log-archive"

MINIO_AUDIT_LOG_RETENTION_DAYS="1095"
MINIO_CHANGE_LOG_RETENTION_DAYS="365"

# ---------------------------------------------------------------------------
# Archiver
# ---------------------------------------------------------------------------

ARCHIVE_AFTER_DAYS="150"
