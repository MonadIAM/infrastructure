# Образы
ZOOKEEPER_IMAGE="confluentinc/cp-zookeeper:7.4.0"
KAFKA_IMAGE="confluentinc/cp-kafka:7.4.0"
KAFKA_UI_IMAGE="provectuslabs/kafka-ui:latest"
GRAFANA_IMAGE="grafana/grafana:10.2.0"
LOKI_IMAGE="grafana/loki:2.9.2"
PROMETHEUS_IMAGE="prom/prometheus:v2.47.2"

# Порты
ZOOKEEPER_CLIENT_PORT="2181"
KAFKA_EXTERNAL_PORT="9092"
KAFKA_INTERNAL_PORT="29092"
KAFKA_UI_PORT="8080"
GRAFANA_PORT="3000"
PROMETHEUS_ACCESS_CONTROL_PORT="9090"
PROMETHEUS_IDENTITY_PORT="9091"
LOKI_ACCESS_CONTROL_PORT="3100"
LOKI_IDENTITY_PORT="3101"

# Сеть
DOCKER_NETWORK_NAME="kafka-net"