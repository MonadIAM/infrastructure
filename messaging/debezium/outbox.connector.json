{
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "${POSTGRES_ROUTE_HOST}",
    "database.port": "${POSTGRES_ROUTE_PORT}",
    "database.user": "${POSTGRES_USER}",
    "database.password": "${POSTGRES_PASSWORD}",
    "database.dbname": "${POSTGRES_DB}",
    "database.sslmode": "disable",
    "topic.prefix": "${SERVICE_NAME}",
    "schema.include.list": "system",
    "table.include.list": "system\\.outbox",
    "plugin.name": "pgoutput",
    "slot.name": "${POSTGRES_OUTBOX_SLOT}",
    "publication.name": "${POSTGRES_OUTBOX_PUBLICATION}",
    "publication.autocreate.mode": "all_tables",
    "snapshot.mode": "no_data",

    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",

    "transforms": "outbox,partition",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.route.by.field": "destination_topic",
    "transforms.outbox.table.field.event.key": "id",
    "transforms.outbox.table.field.event.type": "action_type",
    "transforms.outbox.table.expand.json.payload": "true",
    "transforms.outbox.table.fields.additional.placement": "action_type:envelope:actionType",

    "transforms.partition.type": "io.debezium.transforms.partitions.PartitionRouting",
    "transforms.partition.partition.payload.fields": "payload.realm",
    "transforms.partition.partition.topic.num": "${PROJECTION_JOURNAL_PARTITIONS}",
    "transforms.partition.partition.hash.function": "murmur",
    "transforms.partition.predicate": "projectionJournal",

    "predicates": "projectionJournal",
    "predicates.projectionJournal.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.projectionJournal.pattern": "projection-journal"
}
