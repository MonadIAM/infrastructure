root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.go]
indent_size = 4

[justfile]
indent_size = 4

[*.just]
indent_size = 4

[*.sh]
indent_size = 4
tab_width = 4

[*.sql]
indent_style = space
indent_size = 4
tab_width = 4

[.githooks/*]
indent_size = 4
tab_width = 4
