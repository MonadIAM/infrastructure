      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "clamp_max(sum by (service_name, bullmq_queue_name) (rate({__name__=\"otel_bullmq_spanmetrics_calls_total\", job=\"otel-metrics\", service_name=~\"$service\", bullmq_queue_name!=\"\", bullmq_queue_name=~\"$queue\", status_code=~\".*ERROR|Error|ERROR\"}[$__rate_interval])) / clamp_min(sum by (service_name, bullmq_queue_name) (rate({__name__=\"otel_bullmq_spanmetrics_calls_total\", job=\"otel-metrics\", service_name=~\"$service\", bullmq_queue_name!=\"\", bullmq_queue_name=~\"$queue\"}[$__rate_interval])), 0.001), 1)",
