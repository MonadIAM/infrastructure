          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (service_name, bullmq_queue_name, bullmq_job_name, le) (rate({__name__=\"otel_bullmq_spanmetrics_duration_seconds_bucket\", job=\"otel-metrics\", service_name=~\"$service\", bullmq_queue_name!=\"\", bullmq_queue_name=~\"$queue\", bullmq_queue_operation=\"process\"}[$__rate_interval])))",
          "legendFormat": "{{bullmq_queue_name}} {{bullmq_job_name}} p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (service_name, bullmq_queue_name, bullmq_job_name, le) (rate({__name__=\"otel_bullmq_spanmetrics_duration_seconds_bucket\", job=\"otel-metrics\", service_name=~\"$service\", bullmq_queue_name!=\"\", bullmq_queue_name=~\"$queue\", bullmq_queue_operation=\"process\"}[$__rate_interval])))",
          "legendFormat": "{{bullmq_queue_name}} {{bullmq_job_name}} p95",
          "range": true,
