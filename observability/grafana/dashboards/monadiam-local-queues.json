          "expr": "sum by (service_name, bullmq_queue_name, bullmq_queue_operation, bullmq_job_name) (rate({__name__=\"otel_bullmq_spanmetrics_calls_total\", job=\"otel-metrics\", service_name=~\"$service\", bullmq_queue_name!=\"\", bullmq_queue_name=~\"$queue\"}[$__rate_interval]))",
