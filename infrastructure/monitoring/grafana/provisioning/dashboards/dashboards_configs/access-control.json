{
  "title": "Access Control Service Health",
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 100,
      "title": "System Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "title": "Current uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "time() - process_start_time_seconds" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "Monthly uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 },
      "targets": [
        {
          "expr": "(sum_over_time(up[30d:1m]) or on() vector(0)) / 43200 * 100",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "CPU",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 1 },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total[1m]) * 100" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "showThresholdLabels": false
      }
    },
    {
      "title": "Event Loop LAG",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 1 },
      "targets": [
        { "expr": "nodejs_eventloop_lag_seconds" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "Throttling errors (6h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(app_unhandled_errors_total{type=~\"(?i)throttling|rate\"}[6h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "title": "Database errors (6h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(app_unhandled_errors_total{type=~\"(?i)database|db\"}[6h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "title": "",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 4 },
      "targets": [
        { "expr": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "OFFLINE", "color": "red" },
                "1": { "text": "ONLINE", "color": "green" }
              }
            }
          ]
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "Weekly uptime",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 4 },
      "targets": [
        {
          "expr": "(sum_over_time(up[7d:1m]) or on() vector(0)) / 10080 * 100",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "title": "RAM",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 4 },
      "targets": [
        { "expr": "nodejs_heap_size_used_bytes" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "title": "Total RPS",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 4 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[1m]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "0",
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "title": "Internal errors (6h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 4 },
      "targets": [
        {
          "expr": "sum(increase(app_unhandled_errors_total{type!~\"(?i)database|db|throttling|rate\"}[6h]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 1,
      "title": "API Performance Metrics",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }
    },
    {
      "title": "Most Loaded Endpoints (RPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, sum by (method, route, status) (rate(http_requests_total[1m]))) or (sum by (method, route, status) (rate(http_requests_total[1m])) * 0)",
          "legendFormat": "{{method}} {{route}} ({{status}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "sortBy": "Last",
          "sortDesc": true
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": [ { "name": "Last" } ],
            "sort": [ { "desc": true } ]
          }
        },
        {
          "id": "limit",
          "options": { "limitField": 10 }
        }
      ]
    },
    {
      "title": "Slowest Endpoints (P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prom-Access-Control" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))) or (sum by (route) (rate(http_request_duration_seconds_bucket[5m])) * 0)",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["lastNotNull", "max"],
          "sortBy": "Last",
          "sortDesc": true
        }
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": [ { "name": "Last" } ],
            "sort": [ { "desc": true } ]
          }
        },
        {
          "id": "limit",
          "options": { "limitField": 10 }
        }
      ]
    },
    {
      "id": 3,
      "title": "Application Logs",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "title": "Logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "Loki-Access-Control" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "targets": [
        { "expr": "{job=\"access-control-service\"}" }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending"
      }
    }
  ]
}
