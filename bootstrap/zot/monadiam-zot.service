[Unit]
Description=MonadIAM Zot registry
Requires=docker.service
BindsTo=var-lib-monadiam-zot.mount
After=docker.service var-lib-monadiam-zot.mount
PartOf=docker.service

[Service]
Slice=monadiam.slice
ExecStartPre=/usr/bin/install -d -o 65534 -g 65534 /var/lib/monadiam/zot/data
ExecStart=/usr/bin/docker compose -f /etc/monadiam/zot/compose.yaml up --no-color --exit-code-from zot
Restart=always
RestartSec=5
SuccessExitStatus=130
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
