{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "commit": true,
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "1h",
    "retention": {
      "delay": "24h",
      "policies": [
        {
          "repositories": ["**"],
          "deleteUntagged": true,
          "keepTags": [
            {"patterns": ["^keep-(dev|prod)-.*$"]},
            {"mostRecentlyPushedCount": 5}
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "readTimeout": "10m",
    "writeTimeout": "10m",
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "warn"
  }
}
