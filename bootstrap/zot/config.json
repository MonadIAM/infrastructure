{
  "distSpecVersion": "1.1.1",
  "storage": {
    "rootDirectory": "/var/lib/registry",
    "commit": true,
    "dedupe": true,
    "gc": true,
    "gcDelay": "1h",
    "gcInterval": "1h",
    "retention": {
      "delay": "24h",
      "policies": [
        {
          "repositories": ["**"],
          "deleteUntagged": true,
          "keepUntagged": {
            "mostRecentlyPulledCount": 5
          },
          "keepTags": [
            {"patterns": ["^keep-(dev|prod)-.*$"]},
            {"mostRecentlyPushedCount": 5}
          ]
        }
      ]
    }
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000",
    "readTimeout": "10m",
    "writeTimeout": "10m",
    "compat": ["docker2s2"]
  },
  "log": {
    "level": "warn"
  },
  "extensions": {
    "sync": {
      "enable": true,
      "registries": [
        {
          "urls": ["https://index.docker.io"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/docker.io"}]
        },
        {
          "urls": ["https://ghcr.io"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/ghcr.io"}]
        },
        {
          "urls": ["https://quay.io"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/quay.io"}]
        },
        {
          "urls": ["https://registry.k8s.io"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/registry.k8s.io"}]
        },
        {
          "urls": ["https://registry.istio.io"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/registry.istio.io"}]
        },
        {
          "urls": ["https://ecr-public.aws.com"],
          "onDemand": true,
          "preserveDigest": true,
          "manifestCheckInterval": "24h",
          "content": [{"prefix": "**", "destination": "/ecr-public.aws.com"}]
        }
      ]
    }
  }
}
